# ============================================
# TasteWise 项目 .gitignore
# ============================================

# ===== 敏感配置文件（涉及安全，严禁上传） =====
# DeepSeek API Key（真实密钥，见 apikey.example.php 模板）
backend/config/apikey.php
# 数据库连接配置（含账号密码，见 database.example.php 模板）
backend/config/database.php
# 登录令牌签名密钥（见 security.example.php 模板）
backend/config/security.php
# 微信小程序 AppSecret（见 wechat.example.php 模板）
backend/config/wechat.php
# 管理后台管理员账号与密码哈希（见 admin.example.php 模板）
backend/config/admin.php
# 改密码脚本生成的备份（同样含旧哈希与凭据备忘，严禁上传）
backend/config/admin.php.bak*

# ===== 第三方工具（不属于项目代码） =====
# phpstudy 自带的 phpMyAdmin 数据库管理工具
backend/phpMyAdmin4.8.5/

# ===== 微信开发者工具 =====
# 项目私有配置（含本地开发设置，clone 后自动生成）
frontend/project.private.config.json

# ===== Node / 构建产物 =====
node_modules/
miniprogram_npm/
dist/
build/

# ===== 系统与编辑器文件 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ===== 日志与临时文件 =====
*.log
*.tmp
*.cache
npm-debug.log*
yarn-error.log*

# 数据库备份（含真实数据，绝不入库）
backup/

# ===== 小味角色素材的开发中间产物（处理脚本、原图归档、预览图、改色前备份） =====
# 这些只服务于素材加工，不属于项目代码；需要时本地重新生成即可
.tmp_img/

/* 购物车页面样式 */
.container {
    min-height: 100vh;
    background: #F6F8F9;
    padding-bottom: 120rpx;
  }
  
  /* 购物车列表容器（WXML 用了 cart-list，之前漏写样式） */
  .cart-list {
    padding: 20rpx;
    box-sizing: border-box;
  }
  
  /* 空购物车 */
  .empty-cart {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 120rpx;
  }
  
  /* 空态的小味指引立绘：手指朝右上，正好指向"去首页挑菜"这句话 */
  .empty-pointing {
    width: 340rpx;
    height: 340rpx;
    animation: empty-pointing-in 480ms cubic-bezier(0.22, 1.12, 0.36, 1) 1 both;
  }
  
  @keyframes empty-pointing-in {
    0%   { opacity: 0; transform: translateY(40rpx) scale(0.9); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  
  .empty-icon {
    font-size: 100rpx;
  }
  
  .empty-text {
    font-size: 32rpx;
    color: #999;
    margin-top: 20rpx;
  }
  
  .empty-hint {
    font-size: 26rpx;
    color: #ccc;
    margin-top: 10rpx;
  }
  
  /* 未登录时的去登录按钮 */
  .login-btn {
    margin-top: 40rpx;
    background: #11B3D4;
    color: #fff;
    font-size: 30rpx;
    padding: 15rpx 60rpx;
    border-radius: 10rpx;
  }
  
  /* 购物车列表项 */
  .cart-item {
    display: flex;
    background: #fff;
    padding: 20rpx;
    margin: 10rpx 20rpx;
    border-radius: 15rpx;
  }
  
  .item-img {
    width: 120rpx;
    height: 120rpx;
    border-radius: 10rpx;
    background: #eee;
    flex-shrink: 0;
  }
  
  /* 无菜品图时的占位 */
  .img-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48rpx;
    color: #ccc;
  }
  
  .item-info {
    flex: 1;
    margin-left: 20rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .item-name {
    font-size: 30rpx;
    font-weight: bold;
  }
  
  .item-desc {
    font-size: 24rpx;
    color: #999;
  }
  
  .item-price {
    color: #11B3D4;
    font-size: 28rpx;
  }
  
  .item-right {
    text-align: right;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  /* 数量调整控件（− 数量 +） */
  .qty-box {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  
  .qty-btn {
    width: 48rpx;
    height: 48rpx;
    line-height: 46rpx;
    text-align: center;
    font-size: 34rpx;
    color: #11B3D4;
    border: 1px solid #11B3D4;
    border-radius: 50%;
    background: #fff;
  }
  
  .qty-num {
    min-width: 64rpx;
    text-align: center;
    font-size: 28rpx;
    color: #333;
  }
  
  /* 订单备注 */
  .remark-card {
    display: flex;
    align-items: center;
    background: #fff;
    margin: 10rpx 20rpx;
    padding: 20rpx 25rpx;
    border-radius: 15rpx;
  }
  
  .remark-label {
    font-size: 28rpx;
    color: #666;
    margin-right: 20rpx;
    flex-shrink: 0;
  }
  
  .remark-input {
    flex: 1;
    font-size: 28rpx;
    color: #333;
  }
  
  .remove-btn {
    background: #ff4444;
    color: #fff;
    font-size: 22rpx;
    padding: 5rpx 15rpx;
    border-radius: 5rpx;
  }
  
  /* 底部结算栏 */
  .bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx 30rpx;
    background: #fff;
    border-top: 1px solid #eee;
  }
  
  .total-info {
    font-size: 30rpx;
  }
  
  .total-price {
    color: #11B3D4;
    font-size: 36rpx;
    font-weight: bold;
  }
  
  .checkout-btn {
    background: #11B3D4;
    color: #fff;
    font-size: 30rpx;
    padding: 15rpx 40rpx;
    border-radius: 10rpx;
  }

  /* 空态/失败态的小味立绘 */
  .empty-fail {
    width: 320rpx;
    height: 320rpx;
  }
  
  /* 小味立绘 + 手指位置的按钮（手指朝右上，按钮就摆在右上） */
  .empty-pointing-wrap {
    position: relative;
    width: 360rpx;
    height: 360rpx;
  }
  
  .empty-go-btn {
    position: absolute;
    /* 往右上移，落点对齐小味抬起的指尖，且不压到她的脸 */
    right: -96rpx;
    top: 10rpx;
    display: flex;
    align-items: center;
    gap: 6rpx;
    padding: 14rpx 26rpx;
    border-radius: 40rpx;
    background: #11B3D4;
    color: #fff;
    font-size: 26rpx;
    box-shadow: 0 6rpx 18rpx rgba(17, 179, 212, 0.35);
  }
  
  .empty-go-btn-hover {
    background: #0E93B0;
  }
  
  .empty-go-arrow {
    font-size: 26rpx;
    line-height: 1;
  }
  
  /* 无图占位：小味立绘 */
  .img-ph-img {
    background: #f4f6f8;
  }

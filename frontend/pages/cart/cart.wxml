<view class="container">
  <!-- 未登录提示 -->
  <view wx:if="{{needLogin}}" class="empty-cart">
    <text class="empty-icon">🔒</text>
    <text class="empty-text">请先登录</text>
    <text class="empty-hint">登录后即可使用购物车</text>
    <button class="login-btn" bindtap="onGoLogin">去登录</button>
  </view>

  <!-- 加载失败提示（必须排在「空购物车」前面：
       否则网络一断，用户看到的是「购物车空空如也」，以为自己的菜没了） -->
  <view wx:elif="{{loadError}}" class="empty-cart">
    <text class="empty-icon">⚠️</text>
    <text class="empty-text">{{loadError}}</text>
    <button class="login-btn" bindtap="onRetryLoad">重新加载</button>
  </view>

  <!-- 空购物车提示 -->
  <view wx:elif="{{isEmpty}}" class="empty-cart">
    <text class="empty-icon">🛒</text>
    <text class="empty-text">购物车空空如也</text>
    <text class="empty-hint">快去首页挑选美食吧</text>
  </view>

  <!-- 购物车列表 -->
  <view wx:else class="cart-list">
    <view wx:for="{{cartList}}" wx:key="cart_id" class="cart-item">
      <!-- 有图显示图，无图显示占位（项目内没有 default_dish.png，写死该路径会产生无效图片请求） -->
      <image wx:if="{{item.image_url}}" class="item-img" src="{{item.image_url}}" mode="aspectFill" />
      <view wx:else class="item-img img-ph">🍽️</view>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-desc">{{item.description}}</text>
        <text class="item-price">¥{{item.price}}</text>
      </view>
      <view class="item-right">
        <!-- 数量调整：data-num 直接算好目标数量传给 onChangeQty（减到 0 即移除） -->
        <!-- ⚠️ 重点：data-id 传的是 cart_id，不是 dish_id -->
        <view class="qty-box">
          <view class="qty-btn" data-id="{{item.cart_id}}" data-num="{{item.quantity - 1}}" bindtap="onChangeQty">−</view>
          <text class="qty-num">{{item.quantity}}</text>
          <view class="qty-btn" data-id="{{item.cart_id}}" data-num="{{item.quantity + 1}}" bindtap="onChangeQty">+</view>
        </view>
        <button class="remove-btn" data-id="{{item.cart_id}}" bindtap="onRemove">删除</button>
      </view>
    </view>
  </view>

  <!-- 订单备注（选填，结算时一并提交） -->
  <view wx:if="{{!isEmpty && !needLogin}}" class="remark-card">
    <text class="remark-label">备注</text>
    <input
      class="remark-input"
      placeholder="选填，如：少放辣、不要香菜"
      value="{{remark}}"
      maxlength="50"
      bindinput="onRemarkInput"
    />
  </view>

  <!-- 底部结算栏 -->
  <view wx:if="{{!isEmpty && !needLogin}}" class="bottom-bar">
    <view class="total-info">
      <text>合计：</text>
      <text class="total-price">¥{{totalPrice}}</text>
    </view>
    <button class="checkout-btn" bindtap="onCheckout">结算</button>
  </view>
</view>

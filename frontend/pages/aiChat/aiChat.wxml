<!-- AI助手对话页 -->
<view class="container">
  <!-- 顶部助手信息条 -->
  <view class="ai-header">
    <image class="ai-header-avatar" src="{{avatarSrc}}" mode="aspectFit" binderror="onAvatarError" />
    <view class="ai-header-info">
      <text class="ai-header-name">小味 · AI 点餐助手</text>
      <text class="ai-header-desc">{{sending ? '正在输入…' : '推荐菜品 · 解答口味问题'}}</text>
    </view>
  </view>

  <!-- ============================================
       小味舞台区
       empty：对话为空时铺满（方案 B 欢迎态）
       dock ：进入对话后收成固定高度的常驻舞台区（方案 A）
       点击小味会弹一下（放大后弹回）
       ============================================ -->
  <xiaowei-stage
    state="{{stageState}}"
    variant="{{messages.length <= 1 ? 'empty' : 'dock'}}"
  />

  <!-- 对话列表 -->
  <scroll-view
    class="chat-list"
    scroll-y="true"
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation="true"
  >
    <view
      wx:for="{{messages}}"
      wx:for-index="mi"
      wx:key="index"
      id="msg-{{mi}}"
      class="msg-item {{item.role === 'assistant' ? 'ai-msg' : 'user-msg'}}"
    >
      <!-- AI头像（仅AI消息显示）：用小味头像，加载失败回落成鲸鱼占位 -->
      <view wx:if="{{item.role === 'assistant'}}" class="ai-avatar">
        <image
          wx:if="{{!avatarFailed}}"
          class="ai-avatar-img"
          src="{{avatarSrc}}"
          mode="aspectFit"
          binderror="onAvatarError"
        />
        <text wx:else>🐳</text>
      </view>

      <view class="msg-body">
        <!-- 文本气泡：用 text 组件以保留换行，user-select 允许长按选中复制 -->
        <text class="msg-bubble" user-select="true">{{item.content}}</text>

        <!-- 推荐菜品卡片列表 -->
        <view wx:if="{{item.recommendDishes && item.recommendDishes.length > 0}}" class="recommend-cards">
          <view
            wx:for="{{item.recommendDishes}}"
            wx:for-item="dish"
            wx:for-index="di"
            wx:key="id"
            class="dish-card"
            data-id="{{dish.id}}"
            bindtap="onDishTap"
          >
            <!-- 菜品图片 -->
            <!-- 有图显示图，无图显示占位（项目内没有 default_dish.png） -->
            <!-- binderror：图挂了就清掉 image_url，让下面的 wx:else 兜底图接管。
                 卡片嵌在消息里，所以要 mi（第几条消息）+ di（第几张卡）两级定位 -->
            <image
              wx:if="{{dish.image_url}}"
              class="dish-img"
              src="{{dish.image_url}}"
              mode="aspectFill"
              binderror="onCardImgError"
              data-mi="{{mi}}"
              data-di="{{di}}"
            />
            <image wx:else class="dish-img img-ph-img" src="/assets/xiaowei/diffs/xiaowei-sorry.png" mode="aspectFit" />

            <!-- 菜品信息 -->
            <view class="dish-info">
              <text class="dish-name">{{dish.name}}</text>
              <text wx:if="{{dish.ai_reason}}" class="dish-reason">💡 {{dish.ai_reason}}</text>
              <view class="dish-bottom">
                <text class="dish-price">¥{{dish.price}}</text>
                <!-- 加入购物车：用 view 而不是 button
                     ⚠️ button 组件自带「块级 + 撑满」的默认样式，即便用类选择器覆盖 width
                        也容易在 flex 行里溢出卡片边界；view 没有默认样式，完全可控 -->
                <!-- 用 catchtap 而不是 bindtap：阻止点击冒泡到卡片，
                     否则点「加入购物车」会同时触发卡片跳转详情 -->
                <view
                  class="add-btn"
                  hover-class="add-btn-hover"
                  hover-stay-time="80"
                  data-id="{{dish.id}}"
                  data-name="{{dish.name}}"
                  catchtap="onQuickAddCart"
                >加入购物车</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 用户头像（仅用户消息显示） -->
      <view wx:if="{{item.role === 'user'}}" class="user-avatar">👤</view>
    </view>

    <!-- 「正在输入」/「流式输出中」气泡：替代模态 loading，聊天期间界面不会被遮罩锁住
         有 streamingText 时直接显示正在生成的文字，否则显示三点动画 -->
    <view wx:if="{{sending || streamingText}}" id="msg-typing" class="msg-item ai-msg">
      <view class="ai-avatar">
        <image
          wx:if="{{!avatarFailed}}"
          class="ai-avatar-img"
          src="{{avatarSrc}}"
          mode="aspectFit"
          binderror="onAvatarError"
        />
        <text wx:else>🐳</text>
      </view>
      <view class="msg-body">
        <text wx:if="{{streamingText}}" class="msg-bubble" user-select="true">{{streamingText}}</text>
        <view wx:else class="msg-bubble typing">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 快捷提问（仅对话刚开始时显示，点一下即发送） -->
  <view wx:if="{{messages.length <= 1}}" class="quick-box">
    <view
      wx:for="{{quickQuestions}}"
      wx:key="*this"
      class="quick-item"
      data-text="{{item}}"
      bindtap="onQuickAsk"
    >{{item}}</view>
  </view>

  <!-- 底部输入栏 -->
  <view class="input-bar">
    <input
      class="msg-input"
      placeholder="说说您想吃什么…"
      value="{{inputText}}"
      bindinput="onInputChange"
      confirm-type="send"
      bindconfirm="onSend"
    />
    <button class="send-btn" bindtap="onSend" disabled="{{sending}}">{{sending ? '回复中' : '发送'}}</button>
  </view>
</view>

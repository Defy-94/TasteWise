/* AI助手对话页样式 */

.container {
    display: flex;
    flex-direction: column;
    /* 高度交给文件末尾的 .container { height: 100% } 统一定义：
       这里不写 100vh —— 小程序里 vh 包含 tabBar 区域，会把输入栏顶到 tabBar 下面 */
    background: #f6f7fb;
    /* 下面两条写出来是为了自包含：默认值就是它们，
       显式声明可以防止将来全局样式又加入居中/分散布局影响本页 */
    align-items: stretch;
    justify-content: flex-start;
  }
  
  /* ============================================
     顶部助手信息条
     ============================================ */
  .ai-header {
    display: flex;
    align-items: center;
    gap: 16rpx;
    padding: 20rpx 30rpx;
    background: #fff;
    border-bottom: 1px solid #eee;
    flex-shrink: 0;
  }
  
  .ai-header-avatar {
    width: 72rpx;
    height: 72rpx;
    border-radius: 50%;
    background: #f1f6ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    flex-shrink: 0;
    /* 小味头像是透明底 PNG，加一点内边距免得贴边 */
    padding: 6rpx;
    box-sizing: border-box;
  }
  
  .ai-header-info {
    display: flex;
    flex-direction: column;
    gap: 4rpx;
    min-width: 0;
  }
  
  .ai-header-name {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
  }
  
  .ai-header-desc {
    font-size: 22rpx;
    color: #999;
  }
  
  /* 对话列表 */
  .chat-list {
    flex: 1;
    padding: 24rpx;
    box-sizing: border-box;
  }
  
  .msg-item {
    margin-bottom: 30rpx;
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
  }
  
  .user-msg {
    justify-content: flex-end;
  }
  
  .ai-msg {
    justify-content: flex-start;
  }
  
  /* 头像 */
  .ai-avatar,
  .user-avatar {
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    flex-shrink: 0;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  }
  
  .user-avatar {
    background: #5b93f2;
  }
  
  /* 小味头像图：透明底 PNG，容器是白圆，加内边距防止贴边 */
  .ai-avatar {
    padding: 5rpx;
    box-sizing: border-box;
    overflow: hidden;
  }
  
  .ai-avatar-img {
    width: 100%;
    height: 100%;
  }
  
  /* 消息主体 */
  .msg-body {
    max-width: 75%;
    display: flex;
    flex-direction: column;
  }
  
  .msg-bubble {
    padding: 20rpx 25rpx;
    border-radius: 20rpx;
    font-size: 28rpx;
    line-height: 1.6;
    /* break-word 而不是 break-all：避免中文/英文混排时把单词切碎 */
    word-break: break-word;
    /* 保留 AI 回复中的换行 */
    white-space: pre-wrap;
    display: inline-block;
  }
  
  .user-msg .msg-bubble {
    background: #5b93f2;
    color: #fff;
    border-bottom-right-radius: 5rpx;
  }
  
  .ai-msg .msg-bubble {
    background: #fff;
    color: #333;
    border-bottom-left-radius: 5rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  }
  
  /* ============================================
     「正在输入」动画气泡
     ============================================ */
  .typing {
    display: flex;
    align-items: center;
    gap: 10rpx;
    min-height: 40rpx;
  }
  
  .dot {
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    background: #c2d7fa;
    animation: typing-blink 1.2s infinite ease-in-out;
  }
  
  .dot:nth-child(2) {
    animation-delay: 0.2s;
  }
  
  .dot:nth-child(3) {
    animation-delay: 0.4s;
  }
  
  @keyframes typing-blink {
    0%, 60%, 100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-6rpx);
    }
  }
  
  /* ============================================
     推荐菜品卡片列表
     ============================================ */
  .recommend-cards {
    margin-top: 15rpx;
    display: flex;
    flex-direction: column;
    gap: 15rpx;
  }
  
  .dish-card {
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 15rpx;
    padding: 18rpx;
    gap: 18rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
    /* 保险：即使内部元素异常，也不会溢出卡片边界 */
    overflow: hidden;
  }
  
  .dish-img {
    width: 110rpx;
    height: 110rpx;
    border-radius: 12rpx;
    background: #eee;
    flex-shrink: 0;
  }
  
  /* 无菜品图时的占位 */
  .img-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 44rpx;
    color: #ccc;
  }
  
  .dish-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    min-width: 0;
  }
  
  .dish-name {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .dish-reason {
    font-size: 22rpx;
    color: #999;
    line-height: 1.4;
    /* 推荐理由最多显示两行，超出省略 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* 价格 + 加入按钮同一行，两端对齐
     flex-wrap: wrap 是保险：万一空间不足，按钮换行显示，而不是溢出卡片 */
  .dish-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10rpx;
    margin-top: 4rpx;
  }
  
  .dish-price {
    font-size: 30rpx;
    color: #5b93f2;
    font-weight: bold;
  }
  
  /* 
   * 加入购物车按钮 —— 用 view 实现
   * ⚠️ 之前用 <button> 时即使覆盖了 width:auto / flex:none，按钮仍会溢出卡片边界；
   *    button 组件自带的块级样式很难被类选择器完全压住。
   *    改用 view 后没有任何默认样式，尺寸完全由这里决定，问题从根上消失。
   */
  .add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 52rpx;
    padding: 0 24rpx;
    font-size: 24rpx;
    line-height: 1;
    border-radius: 26rpx;
    background: #5b93f2;
    color: #fff;
    box-sizing: border-box;
  }
  
  /* 点击反馈（替代 button 的默认按压效果） */
  .add-btn-hover {
    background: #e55a2b;
  }
  
  /* ============================================
     快捷提问
     ============================================ */
  .quick-box {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
    padding: 20rpx 24rpx 16rpx;
    background: #fff;
    flex-shrink: 0;
  }
  
  .quick-item {
    font-size: 24rpx;
    color: #5b93f2;
    background: #f1f6ff;
    border-radius: 30rpx;
    padding: 12rpx 26rpx;
  }
  
  .quick-item:active {
    background: #FFE0D2;
  }
  
  /* ============================================
     底部输入栏
     ============================================ */
  .input-bar {
    display: flex;
    padding: 16rpx 24rpx;
    background: #fff;
    border-top: 1px solid #eee;
    align-items: center;
    gap: 16rpx;
    flex-shrink: 0;
  }
  
  .msg-input {
    flex: 1;
    /* min-width:0 让输入框可以被压缩，避免占位文字把布局撑破 */
    min-width: 0;
    height: 72rpx;
    line-height: 72rpx;
    border-radius: 36rpx;
    padding: 0 28rpx;
    font-size: 28rpx;
    background: #f6f7fb;
    box-sizing: border-box;
  }
  
  /* 与输入框等高、固定宽度的紧凑按钮（不再用 padding 撑宽度） */
  .send-btn {
    flex-shrink: 0;
    width: 120rpx;
    height: 72rpx;
    line-height: 72rpx;
    padding: 0;
    margin: 0;
    border-radius: 36rpx;
    font-size: 28rpx;
    background: #5b93f2;
    color: #fff;
  }
  
  .send-btn[disabled] {
    background: #c6d9fa;
    color: #fff;
  }
  
  /* ============================================
     页面容器：让 .container 的 100% 高度真正生效
     
     原来 .container 用的是 height: 100vh，但小程序页面里 vh 含 tabBar 区域，
     加了舞台区之后会出现「输入栏被 tabBar 压住」的问题。
     改成 page 占满可视区、容器用 100%，再由 flex 分配：
       舞台区（固定/可伸缩） + 消息区（flex:1 滚动） + 输入栏（固定）
     这样键盘弹起时高度变化也会被 flex 正确吸收。
     ============================================ */
  page {
    height: 100%;
    overflow: hidden;
  }
  
  .container {
    height: 100%;
  }
  
  /* 消息区要能被子元素撑开并内部滚动，必须允许收缩 */
  .chat-list {
    min-height: 0;
    overflow: hidden;
  }


/* 登录页面样式（微信一键登录） */
.login-container {
    min-height: 100vh;
    background: #F6F8F9;
  }
  
  .nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    background: #fff;
    border-bottom: 1px solid #eee;
  }
  
  .back-btn {
    font-size: 28rpx;
    color: #11B3D4;
  }
  
  .nav-title {
    font-size: 34rpx;
    font-weight: bold;
  }
  
  .nav-placeholder {
    width: 100rpx;
  }
  
  .form-section {
    margin: 40rpx 30rpx;
    background: #fff;
    border-radius: 20rpx;
    padding: 60rpx 40rpx;
  }
  
  /* 品牌区 */
  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 40rpx;
  }
  
  .brand-logo {
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
    /* 小味头像是方形透明底 PNG，留一点内边距避免贴到圆边 */
    padding: 10rpx;
    box-sizing: border-box;
  }
  
  .brand-name {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    margin-top: 20rpx;
  }
  
  .brand-desc {
    font-size: 26rpx;
    color: #999;
    margin-top: 12rpx;
  }
  
  /* 微信一键登录按钮 */
  .submit-btn {
    margin-top: 60rpx;
    background: #11B3D4;
    color: #fff;
    font-size: 32rpx;
    font-weight: bold;
    padding: 20rpx 0;
    border-radius: 40rpx;
  }
  
  .submit-btn[disabled] {
    background: #BADFEA;
    color: #fff;
  }
  
  .form-tip {
    text-align: center;
    margin-top: 30rpx;
    font-size: 22rpx;
    color: #ccc;
  }

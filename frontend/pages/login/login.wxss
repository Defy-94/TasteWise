/* 登录页面样式（微信一键登录） */
.login-container {
    min-height: 100vh;
    background: #f6f7fb;
  }
  
  .nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    background: #fff;
    border-bottom: 1px solid #eee;
  }
  
  .back-btn {
    font-size: 28rpx;
    color: #5b93f2;
  }
  
  .nav-title {
    font-size: 34rpx;
    font-weight: bold;
  }
  
  .nav-placeholder {
    width: 100rpx;
  }
  
  .form-section {
    margin: 40rpx 30rpx;
    background: #fff;
    border-radius: 20rpx;
    padding: 60rpx 40rpx;
  }
  
  /* 品牌区 */
  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 40rpx;
  }
  
  .brand-logo {
    font-size: 110rpx;
    line-height: 1;
  }
  
  .brand-name {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    margin-top: 20rpx;
  }
  
  .brand-desc {
    font-size: 26rpx;
    color: #999;
    margin-top: 12rpx;
  }
  
  /* 微信一键登录按钮 */
  .submit-btn {
    margin-top: 60rpx;
    background: #5b93f2;
    color: #fff;
    font-size: 32rpx;
    font-weight: bold;
    padding: 20rpx 0;
    border-radius: 40rpx;
  }
  
  .submit-btn[disabled] {
    background: #c6d9fa;
    color: #fff;
  }
  
  .form-tip {
    text-align: center;
    margin-top: 30rpx;
    font-size: 22rpx;
    color: #ccc;
  }

/* 登录页面样式 - 【新增代码】 */
.login-container {
    min-height: 100vh;
    background: #f5f5f5;
  }
  
  .nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    background: #fff;
    border-bottom: 1px solid #eee;
  }
  
  .back-btn {
    font-size: 28rpx;
    color: #FF6B35;
  }
  
  .nav-title {
    font-size: 34rpx;
    font-weight: bold;
  }
  
  .nav-placeholder {
    width: 100rpx;
  }
  
  .form-section {
    margin: 40rpx 30rpx;
    background: #fff;
    border-radius: 20rpx;
    padding: 40rpx 30rpx;
  }
  
  .form-item {
    display: flex;
    align-items: center;
    padding: 25rpx 0;
    border-bottom: 1px solid #f0f0f0;
  }
  
  .form-label {
    width: 140rpx;
    font-size: 28rpx;
    color: #333;
  }
  
  .form-input {
    flex: 1;
    font-size: 28rpx;
    padding: 10rpx;
  }
  
  .submit-btn {
    margin-top: 50rpx;
    background: #FF6B35;
    color: #fff;
    font-size: 32rpx;
    font-weight: bold;
    padding: 20rpx 0;
    border-radius: 40rpx;
  }
  
  .form-tip {
    text-align: center;
    margin-top: 30rpx;
    font-size: 22rpx;
    color: #ccc;
  }
<!-- 登录页面：微信一键登录 -->
<view class="login-container">
  <!-- 顶部返回栏 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="onBack">← 返回</view>
    <text class="nav-title">登录</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 登录区域 -->
  <view class="form-section">
    <view class="brand">
      <image class="brand-logo" src="/assets/xiaowei/ui/xiaowei-avatar.png" mode="aspectFit" />
      <view class="brand-name">智味 · AI 点餐</view>
      <view class="brand-desc">使用微信一键登录，安全快捷</view>
    </view>

    <!-- 微信一键登录：前端 wx.login 取 code，后端换取 openid 并签发登录令牌 -->
    <button class="submit-btn" bindtap="onWxLogin" disabled="{{logging}}">
      {{logging ? '登录中...' : '微信一键登录'}}
    </button>

    <!-- 底部提示 -->
    <view class="form-tip">
      <text>首次登录将自动创建账号，无需单独注册</text>
    </view>
  </view>
</view>

/* 关于页面样式 */
.about-container {
    min-height: 100vh;
    background: linear-gradient(180deg, #5b93f2 0%, #a8c4f7 30%, #f6f7fb 30%);
    padding-bottom: 40rpx;
  }
  
  /* Logo区域 */
  .logo-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 80rpx 0 40rpx;
  }
  /* Logo区域：改成小味头像图（原来是餐具 emoji 文本）
     头像本身是透明底，仍然保留白色圆底 + 阴影，和之前的观感一致 */
  .logo-icon {
    width: 180rpx;
    height: 180rpx;
    background: rgba(255,255,255,0.9);
    border-radius: 50%;
    box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.15);
    /* 头像是方形图，用 padding 留白避免贴到圆边 */
    padding: 10rpx;
    box-sizing: border-box;
  }
  .app-name {
    font-size: 48rpx;
    font-weight: bold;
    color: #fff;
    margin-top: 30rpx;
    text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
  }
  .version {
    font-size: 24rpx;
    color: rgba(255,255,255,0.8);
    margin-top: 8rpx;
  }
  
  /* 通用区块样式 */
  .desc-section,
  .tech-section,
  .dev-section,
  .gallery-section {
    background: #fff;
    margin: 20rpx 30rpx;
    border-radius: 20rpx;
    padding: 30rpx;
    box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  }
  .section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 20rpx;
  }
  
  /* ============================================
     小味表情差分：横向滑动展示
     
     为什么用 scroll-view + 一条横向 track 而不是 swiper：
       swiper 一次只显示一张，看不出"她有很多表情"；
       横向列表能同时露出下一张，滑动意图更明确。
     图片是透明底 PNG，所以每张外面套一个浅底圆角容器，
     既统一了视觉，也让透明区域有依托、不会显得"飘"。
     ============================================ */
  
  .gallery-tip {
    display: block;
    font-size: 22rpx;
    color: #aaa;
    margin: -10rpx 0 18rpx;
  }
  
  .gallery-scroll {
    width: 100%;
    white-space: nowrap;
  }
  
  .gallery-track {
    display: inline-flex;
    align-items: flex-start;
    /* 左侧留一点内边距，第一张不要贴边 */
    padding-left: 4rpx;
  }
  
  .gallery-item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    width: 210rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
  }
  
  .gallery-item:active {
    opacity: 0.85;
  }
  
  .gallery-thumb {
    width: 210rpx;
    height: 210rpx;
    border-radius: 18rpx;
    background: linear-gradient(180deg, #f1f6ff 0%, #fafbff 100%);
    border: 1rpx solid #e8eefb;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  .gallery-img {
    width: 100%;
    height: 100%;
  }
  
  .gallery-label {
    font-size: 26rpx;
    color: #333;
    font-weight: bold;
    margin-top: 14rpx;
  }
  
  .gallery-desc {
    font-size: 20rpx;
    color: #aaa;
    margin-top: 4rpx;
    text-align: center;
    line-height: 1.4;
    white-space: normal;
  }
  
  /* 描述区域 */
  .desc-text {
    font-size: 28rpx;
    color: #666;
    line-height: 1.8;
    white-space: pre-line;
  }
  
  /* 技术栈区域 */
  .tech-item {
    display: flex;
    padding: 12rpx 0;
    font-size: 28rpx;
    color: #555;
    border-bottom: 1px solid #f6f7fb;
  }
  .tech-item text:first-child {
    width: 160rpx;
    color: #999;
  }
  
  /* 开发者信息 */
  .dev-text {
    display: block;
    font-size: 26rpx;
    color: #666;
    padding: 8rpx 0;
  }
  
  /* 底部版权 */
  .footer {
    text-align: center;
    padding: 40rpx 0;
    font-size: 22rpx;
    color: #ccc;
  }
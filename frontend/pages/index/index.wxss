/* 首页样式 */
.container {
    padding-bottom: 20rpx;
    background: #f5f5f5;
    padding-top: 0;
  }
  
  /* 菜品搜索 */
  .search-bar {
    display: flex;
    align-items: center;
    gap: 10rpx;
    padding: 16rpx 20rpx;
    background: #fff;
  }
  
  .search-input {
    flex: 1;
    /* min-width: 0 是必须的：flex 子项默认最小宽度等于内容宽度，
       输入框会因此撑破容器、把右边的清空按钮挤出去 */
    min-width: 0;
    height: 64rpx;
    padding: 0 24rpx;
    background: #f5f5f5;
    border-radius: 32rpx;
    font-size: 28rpx;
  }
  
  /* 清空搜索按钮 */
  .search-clear {
    flex-shrink: 0;
    width: 48rpx;
    height: 48rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #eee;
    color: #999;
    font-size: 26rpx;
  }
  
  .search-clear-hover {
    background: #ddd;
  }
  
  /* 空结果提示 */
  .dish-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 60rpx;
  }
  
  .dish-empty-icon {
    font-size: 90rpx;
    margin-bottom: 20rpx;
  }
  
  .dish-empty-text {
    font-size: 28rpx;
    color: #999;
    text-align: center;
    line-height: 1.6;
  }
  
  .dish-empty-btn {
    margin-top: 32rpx;
    min-width: 220rpx;
    height: 68rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 34rpx;
    background: #FF6B35;
    color: #fff;
    font-size: 28rpx;
  }
  
  .dish-empty-btn-hover {
    background: #e55a2b;
  }
  
  /* AI搜索栏 */
  .ai-search-bar {
    display: flex;
    justify-content: space-between;
    padding: 20rpx;
    background: #fff;
    gap: 10rpx;
  }
  
  .ai-input {
    flex: 0 0 60%;
    border: 1px solid #ddd;
    border-radius: 10rpx;
    padding: 15rpx 20rpx;
    font-size: 28rpx;
  }
  
  .ai-btn {
    width: 160rpx;
    background: #FF6B35;
    color: #fff;
    font-size: 26rpx;
    border-radius: 10rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  /* 分类导航 */
  .category-scroll {
    white-space: nowrap;
    padding: 20rpx;
    padding-left: 7%;
    background: #fff;
    margin-bottom: 10rpx；
  }
  
  .category-item {
    display: inline-block;
    padding: 10rpx 30rpx;
    margin-right: 10rpx;
    border-radius: 30rpx;
    background: #f0f0f0;
    font-size: 28rpx;
  }
  
  .category-item.active {
    background: #FF6B35;
    color: #fff;
  }
  
  /* 菜品列表 */
  .dish-list {
    padding: 15rpx 20rpx;
    justify-content: space-between;
  }
  
  .dish-card {
    display: flex;
    background: #fff;
    border-radius: 15rpx;
    margin-bottom: 20rpx;
    overflow: hidden;
  }
  
  .dish-img {
    width: 200rpx;
    height: 200rpx;
    background: #eee;
    flex-shrink: 0;
  }
  
  /* 无菜品图时的占位 */
  .img-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 72rpx;
    color: #ccc;
  }
  
  .dish-info {
    flex: 1;
    padding: 20rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .dish-name {
    font-size: 32rpx;
    font-weight: bold;
  }
  
  .dish-desc {
    font-size: 24rpx;
    color: #999;
  }
  
  .dish-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .dish-price {
    font-size: 32rpx;
    color: #FF6B35;
    font-weight: bold;
  }
  
  /* 加入购物车按钮（改用 view 实现，不受 button 组件默认块级宽度影响） */
  .add-cart-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 56rpx;
    padding: 0 24rpx;
    font-size: 24rpx;
    line-height: 1;
    border-radius: 28rpx;
    background: #FF6B35;
    color: #fff;
    box-sizing: border-box;
  }
  
  /* 点击反馈（替代 button 的默认按压效果） */
  .add-cart-btn-hover {
    background: #e55a2b;
  }
  
  /* 售罄：置灰且不可点（与菜品详情页的「已售完」保持一致） */
  .add-cart-btn-disabled {
    background: #ccc;
  }
  
  /* AI推荐弹窗 */
  .recommend-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 100;
  }
  
  .modal-content {
    width: 80%;
    background: #fff;
    border-radius: 20rpx;
    padding: 30rpx;
    max-height: 70vh;
    overflow-y: auto;
  }
  
  .modal-header {
    display: flex;
    justify-content: space-between;
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
  }
  
  .close-btn {
    color: #999;
  }
  
  .recommend-item {
    padding: 20rpx;
    border-bottom: 1px solid #eee;
  }
  
  /* 推荐项点击反馈（点一下进菜品详情） */
  .recommend-item-hover {
    background: #fafafa;
  }
  
  .rec-name {
    font-weight: bold;
    font-size: 28rpx;
  }
  
  .rec-price {
    color: #FF6B35;
    margin-left: 20rpx;
  }
  
  .rec-reason {
    display: block;
    font-size: 24rpx;
    color: #666;
    margin-top: 8rpx;
  }
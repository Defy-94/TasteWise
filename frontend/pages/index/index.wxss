/* 首页样式 */
.container {
    padding-bottom: 20rpx;
    background: #f6f7fb;
    padding-top: 0;
  }
  
  /* 菜品搜索 */
  .search-bar {
    display: flex;
    align-items: center;
    gap: 10rpx;
    padding: 16rpx 20rpx;
    background: #fff;
  }
  
  .search-input {
    flex: 1;
    /* min-width: 0 是必须的：flex 子项默认最小宽度等于内容宽度，
       输入框会因此撑破容器、把右边的清空按钮挤出去 */
    min-width: 0;
    height: 64rpx;
    padding: 0 24rpx;
    background: #f6f7fb;
    border-radius: 32rpx;
    font-size: 28rpx;
  }
  
  /* 清空搜索按钮 */
  .search-clear {
    flex-shrink: 0;
    width: 48rpx;
    height: 48rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #eee;
    color: #999;
    font-size: 26rpx;
  }
  
  .search-clear-hover {
    background: #ddd;
  }
  
  /* 空结果提示 */
  .dish-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 60rpx;
  }
  
  .dish-empty-icon {
    font-size: 90rpx;
    margin-bottom: 20rpx;
  }
  
  .dish-empty-text {
    font-size: 28rpx;
    color: #999;
    text-align: center;
    line-height: 1.6;
  }
  
  .dish-empty-btn {
    margin-top: 32rpx;
    min-width: 220rpx;
    height: 68rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 34rpx;
    background: #5b93f2;
    color: #fff;
    font-size: 28rpx;
  }
  
  .dish-empty-btn-hover {
    background: #e55a2b;
  }
  
  /* AI搜索栏 */
  .ai-search-bar {
    display: flex;
    justify-content: space-between;
    padding: 20rpx;
    background: #fff;
    gap: 10rpx;
  }
  
  .ai-input {
    flex: 0 0 60%;
    border: 1px solid #ddd;
    border-radius: 10rpx;
    padding: 15rpx 20rpx;
    font-size: 28rpx;
  }
  
  .ai-btn {
    width: 160rpx;
    background: #5b93f2;
    color: #fff;
    font-size: 26rpx;
    border-radius: 10rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  /* ============================================
     小味浮窗（AI 推荐提示）
     
     长期常驻：不做关闭按钮、不做过期隐藏。
     也正因为常驻，它不再是一个"提示气泡"，而是 AI 推荐入口的一部分，
     点击直接进 AI 助手页。

     为什么放在文档流里而不是 fixed：
       它要"贴着 AI 推荐栏下方"，跟着页面滚动一起走更符合预期；
       用 fixed 的话滚到列表中间时它会盖住菜品卡片。
     ============================================ */
  
  .xiaowei-tip {
    display: flex;
    align-items: center;
    gap: 14rpx;
    margin: -6rpx 20rpx 12rpx;
    padding: 12rpx 16rpx;
    background: #fff;
    border: 1rpx solid #e4ecfb;
    border-radius: 16rpx;
    box-shadow: 0 6rpx 18rpx rgba(60, 100, 180, 0.10);
    animation: tip-in 260ms ease-out both;
  }
  
  /* 按下时轻微回缩，让它看起来是可点的入口而不是静态提示 */
  .xiaowei-tip:active {
    background: #f7faff;
    transform: scale(0.99);
  }
  
  .xiaowei-tip-avatar {
    width: 68rpx;
    height: 68rpx;
    flex-shrink: 0;
  }
  
  .xiaowei-tip-text {
    display: flex;
    flex-direction: column;
    gap: 4rpx;
    flex: 1;
    min-width: 0;
  }
  
  .xiaowei-tip-title {
    font-size: 26rpx;
    font-weight: bold;
    color: #333;
  }
  
  .xiaowei-tip-sub {
    font-size: 22rpx;
    color: #999;
  }
  
  /* 右侧箭头：暗示"可点进去" */
  .xiaowei-tip-arrow {
    flex-shrink: 0;
    font-size: 34rpx;
    line-height: 1;
    color: #c3cfe6;
    padding: 0 4rpx;
  }
  
  @keyframes tip-in {
    0% {
      opacity: 0;
      transform: translateY(-10rpx);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* 分类导航 */
  .category-scroll {
    white-space: nowrap;
    padding: 20rpx;
    padding-left: 7%;
    background: #fff;
    margin-bottom: 10rpx；
  }
  
  .category-item {
    display: inline-block;
    padding: 10rpx 30rpx;
    margin-right: 10rpx;
    border-radius: 30rpx;
    background: #f0f0f0;
    font-size: 28rpx;
  }
  
  .category-item.active {
    background: #5b93f2;
    color: #fff;
  }
  
  /* 菜品列表 */
  .dish-list {
    padding: 15rpx 20rpx;
    justify-content: space-between;
  }
  
  .dish-card {
    display: flex;
    background: #fff;
    border-radius: 15rpx;
    margin-bottom: 20rpx;
    overflow: hidden;
  }
  
  .dish-img {
    width: 200rpx;
    height: 200rpx;
    background: #eee;
    flex-shrink: 0;
  }
  
  /* 无菜品图时的占位 */
  .img-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 72rpx;
    color: #ccc;
  }
  
  .dish-info {
    flex: 1;
    padding: 20rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .dish-name {
    font-size: 32rpx;
    font-weight: bold;
  }
  
  /* ---------- 供应情况标签 ---------- */
  
  .dish-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10rpx;
  }
  
  .dish-name-row .dish-name {
    /* 菜名过长时先省略，不要挤掉右边的供应标签 */
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .supply {
    flex-shrink: 0;
    font-size: 20rpx;
    line-height: 1;
    padding: 6rpx 12rpx;
    border-radius: 20rpx;
  }
  
  .supply-ok {
    color: #2f9e6b;
    background: #eaf7f0;
  }
  
  .supply-tight {
    color: #d08a1e;
    background: #fdf4e3;
  }
  
  .supply-out {
    color: #999;
    background: #f0f0f0;
  }
  
  .dish-desc {
    font-size: 24rpx;
    color: #999;
  }
  
  .dish-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .dish-price {
    font-size: 32rpx;
    color: #5b93f2;
    font-weight: bold;
  }
  
  /* 加入购物车按钮（改用 view 实现，不受 button 组件默认块级宽度影响） */
  .add-cart-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 56rpx;
    padding: 0 24rpx;
    font-size: 24rpx;
    line-height: 1;
    border-radius: 28rpx;
    background: #5b93f2;
    color: #fff;
    box-sizing: border-box;
  }
  
  /* 点击反馈（替代 button 的默认按压效果） */
  .add-cart-btn-hover {
    background: #e55a2b;
  }
  
  /* 售罄：置灰且不可点（与菜品详情页的「已售完」保持一致） */
  .add-cart-btn-disabled {
    background: #ccc;
  }
  
  /* AI推荐弹窗 */
  .recommend-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 100;
  }
  
  .modal-content {
    width: 80%;
    background: #fff;
    border-radius: 20rpx;
    padding: 30rpx;
    max-height: 70vh;
    overflow-y: auto;
  }
  
  .modal-header {
    display: flex;
    justify-content: space-between;
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
  }
  
  .close-btn {
    color: #999;
  }
  
  .recommend-item {
    padding: 20rpx;
    border-bottom: 1px solid #eee;
  }
  
  /* 推荐项点击反馈（点一下进菜品详情） */
  .recommend-item-hover {
    background: #fafafa;
  }
  
  .rec-name {
    font-weight: bold;
    font-size: 28rpx;
  }
  
  .rec-price {
    color: #5b93f2;
    margin-left: 20rpx;
  }
  
  .rec-reason {
    display: block;
    font-size: 24rpx;
    color: #666;
    margin-top: 8rpx;
  }
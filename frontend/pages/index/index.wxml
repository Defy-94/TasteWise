<view class="container">
  <!-- 菜品搜索：边打字边搜（防抖 350ms），回车立即出结果 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索菜名，如 汤 / 鸡丁 / 辣"
      value="{{searchKeyword}}"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
    <!-- 有内容时才显示清空按钮 -->
    <view
      wx:if="{{searchKeyword}}"
      class="search-clear"
      hover-class="search-clear-hover"
      hover-stay-time="60"
      bindtap="onClearSearch"
    >✕</view>
  </view>

  <!-- AI 推荐入口：点击进入 AI 助手对话页 -->

  <view class="xiaowei-tip" bindtap="onTapXiaoweiTip">
    <image class="xiaowei-tip-avatar" src="/assets/xiaowei/ui/xiaowei-pointing-sm.png" mode="aspectFit" />
    <view class="xiaowei-tip-text">
      <text class="xiaowei-tip-title">可以试试小味推荐</text>
      <text class="xiaowei-tip-sub">说说口味，我来帮你挑</text>
    </view>
    <view class="xiaowei-tip-arrow">›</view>
  </view>

  <!-- 分类导航 -->
  <scroll-view class="category-scroll" scroll-x="true">
    <view 
      wx:for="{{categories}}" 
      wx:key="id" 
      class="category-item {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 菜品列表 -->
  <view class="dish-list">
    <!-- 点卡片任意位置进菜品详情页 -->
    <view wx:for="{{dishes}}" wx:key="id" class="dish-card" data-id="{{item.id}}" bindtap="onDishTap">
      <!-- 有图显示图，无图显示占位（项目内没有 default_dish.png，避免无效图片请求） -->
      <!-- binderror：图挂了就清掉 image_url，让下面的 wx:else 兜底图接管，
           否则外链失效时这里是一块空白 -->
      <image
        wx:if="{{item.image_url}}"
        class="dish-img"
        src="{{item.image_url}}"
        mode="aspectFill"
        binderror="onDishImgError"
        data-index="{{index}}"
      />
      <!-- 无图时用小味（为难表情）占位，比一个餐具 emoji 更有品牌感 -->
            <image wx:else class="dish-img img-ph-img" src="/assets/xiaowei/diffs/xiaowei-sorry.png" mode="aspectFit" />
      <view class="dish-info">
        <view class="dish-name-row">
          <view class="dish-name">{{item.name}}</view>
          <!-- 供应情况：只用两档措辞，不显示具体份数 -->
          <view class="supply {{item.supplyLabel === '供应紧张' ? 'supply-tight' : (item.supplyLabel === '已售完' ? 'supply-out' : 'supply-ok')}}">
            {{item.supplyLabel}}
          </view>
        </view>
        <view class="dish-desc">{{item.description}}</view>
        <view class="dish-bottom">
          <text class="dish-price">¥{{item.price}}</text>
  <!-- 售罄时直接禁用，不要等结算才拦 -->
          <view
            wx:if="{{item.stock > 0}}"
            class="add-cart-btn"
            hover-class="add-cart-btn-hover"
            hover-stay-time="80"
            data-id="{{item.id}}"
            catchtap="onAddToCart"
          >加入购物车</view>
          <view wx:else class="add-cart-btn add-cart-btn-disabled">已售完</view>
        </view>
      </view>
    </view>
  </view>
  <!-- 失败态必须排在空结果前面，否则断网时会被误认为"店里没菜" -->
  <view wx:if="{{loadError}}" class="dish-empty">
    <image class="dish-empty-img" src="/assets/xiaowei/diffs/xiaowei-sorry.png" mode="aspectFit" />
    <view class="dish-empty-text">加载失败</view>
    <view class="dish-empty-sub">{{loadError}}</view>
    <view
      class="dish-empty-btn"
      hover-class="dish-empty-btn-hover"
      hover-stay-time="60"
      bindtap="onRetryLoad"
    >重新加载</view>
  </view>
  <!-- 区分「搜不到」与「该分类下没菜」两种情况 -->
  <view wx:elif="{{!loadingDishes && dishes.length === 0}}" class="dish-empty">
    <view class="dish-empty-icon">🔍</view>
    <view class="dish-empty-text">
      {{searchKeyword ? '没有找到与「' + searchKeyword + '」相关的菜品' : '该分类下暂时没有菜品'}}
    </view>
    <view
      wx:if="{{searchKeyword}}"
      class="dish-empty-btn"
      hover-class="dish-empty-btn-hover"
      hover-stay-time="60"
      bindtap="onClearSearch"
    >清空搜索</view>
  </view>

</view>

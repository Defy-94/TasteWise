<!-- 首页 - 菜品列表 -->
<view class="container">
  <!-- 菜品搜索：边打字边搜（防抖 350ms），回车立即出结果 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索菜名，如 汤 / 鸡丁 / 辣"
      value="{{searchKeyword}}"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
    <!-- 有内容时才显示清空按钮 -->
    <view
      wx:if="{{searchKeyword}}"
      class="search-clear"
      hover-class="search-clear-hover"
      hover-stay-time="60"
      bindtap="onClearSearch"
    >✕</view>
  </view>

  <!-- AI推荐搜索栏 -->
  <view class="ai-search-bar">
    <input 
      class="ai-input" 
      placeholder="描述口味偏好，AI为您推荐" 
      value="{{preferenceInput}}" 
      bindinput="onPreferenceInput"
      confirm-type="search"
      bindconfirm="onAIRecommend"
    />
    <!-- 按钮：AI推荐，绑定后端接口 /api/dish/recommend.php -->
    <button class="ai-btn" bindtap="onAIRecommend">AI推荐</button>
  </view>

  <!-- 分类导航 -->
  <scroll-view class="category-scroll" scroll-x="true">
    <view 
      wx:for="{{categories}}" 
      wx:key="id" 
      class="category-item {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 菜品列表 -->
  <view class="dish-list">
    <!-- 点卡片任意位置进菜品详情页 -->
    <view wx:for="{{dishes}}" wx:key="id" class="dish-card" data-id="{{item.id}}" bindtap="onDishTap">
      <!-- 有图显示图，无图显示占位（项目内没有 default_dish.png，避免无效图片请求） -->
      <image wx:if="{{item.image_url}}" class="dish-img" src="{{item.image_url}}" mode="aspectFill" />
      <view wx:else class="dish-img img-ph">🍽️</view>
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-desc">{{item.description}}</view>
        <view class="dish-bottom">
          <text class="dish-price">¥{{item.price}}</text>
          <!-- 按钮：加入购物车，绑定后端接口 POST /api/cart/add.php -->
          <!-- 加入购物车：用 view 而非 button（button 自带块级默认宽度，容易溢出/占满整行） -->
          <!-- 用 catchtap 而非 bindtap：阻止冒泡到卡片，否则会同时跳转详情页 -->
          <view class="add-cart-btn" hover-class="add-cart-btn-hover" hover-stay-time="80" data-id="{{item.id}}" catchtap="onAddToCart">加入购物车</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载失败：必须和「空结果」区分开，
       否则网络一断用户看到的是「该分类下暂时没有菜品」，会以为店里没菜 -->
  <view wx:if="{{loadError}}" class="dish-empty">
    <view class="dish-empty-icon">⚠️</view>
    <view class="dish-empty-text">{{loadError}}</view>
    <view
      class="dish-empty-btn"
      hover-class="dish-empty-btn-hover"
      hover-stay-time="60"
      bindtap="onRetryLoad"
    >重新加载</view>
  </view>

  <!-- 空结果提示 -->
  <!-- 要区分「搜不到」和「这个分类下本来就没菜」两种情况，
       否则用户面对一片空白，不知道是自己搜错了还是店里确实没有 -->
  <view wx:elif="{{!loadingDishes && dishes.length === 0}}" class="dish-empty">
    <view class="dish-empty-icon">🔍</view>
    <view class="dish-empty-text">
      {{searchKeyword ? '没有找到与「' + searchKeyword + '」相关的菜品' : '该分类下暂时没有菜品'}}
    </view>
    <view
      wx:if="{{searchKeyword}}"
      class="dish-empty-btn"
      hover-class="dish-empty-btn-hover"
      hover-stay-time="60"
      bindtap="onClearSearch"
    >清空搜索</view>
  </view>

  <!-- AI推荐弹窗 -->
  <view wx:if="{{showRecommend}}" class="recommend-modal">
    <view class="modal-content">
      <view class="modal-header">
        <text>AI推荐结果</text>
        <text class="close-btn" bindtap="onCloseRecommend">✕</text>
      </view>
      <!-- 推荐项也可以点进详情 -->
      <view
        wx:for="{{recommendDishes}}"
        wx:key="id"
        class="recommend-item"
        hover-class="recommend-item-hover"
        hover-stay-time="80"
        data-id="{{item.id}}"
        bindtap="onDishTap"
      >
        <text class="rec-name">{{item.name}}</text>
        <text class="rec-price">¥{{item.price}}</text>
        <text class="rec-reason">{{item.ai_reason}}</text>
      </view>
    </view>
  </view>
</view>
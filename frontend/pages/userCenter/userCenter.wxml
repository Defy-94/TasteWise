<!-- 用户中心页面（「我的」） -->
<view class="container">
  <!-- ========== 顶部用户卡（渐变背景） ========== -->
  <view class="hero">
    <view class="hero-main">
      <!-- 有头像就显示头像；没有则显示占位图标
           （项目内并没有 default_avatar.png 这张兜底图，写死路径会渲染出一个空白圆圈） -->
      <image wx:if="{{userInfo.avatar_url}}" class="avatar" src="{{userInfo.avatar_url}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-ph">👤</view>

      <view class="hero-info">
        <block wx:if="{{isLoggedIn}}">
          <text class="hero-name">{{userInfo.nickname || userInfo.username || '微信用户'}}</text>
          <text class="hero-sub">{{userInfo.phone || '未绑定手机号'}}</text>
        </block>
        <block wx:else>
          <text class="hero-name">未登录</text>
          <text class="hero-sub">登录后可点餐、查看订单</text>
        </block>
      </view>

      <!-- 未登录：一键登录按钮；已登录：编辑资料 -->
      <view wx:if="{{!isLoggedIn}}" class="hero-btn" bindtap="onGoLogin">微信登录</view>
      <view wx:elif="{{!isEditing}}" class="hero-btn" bindtap="onEdit">编辑资料</view>
      <view wx:elif="{{isEditing}}" class="hero-btn" bindtap="onCancelEdit">取消编辑</view>
    </view>
  </view>

  <!-- ========== 订单概览：各状态数量，点击直达对应筛选 ========== -->
  <view class="card orders-overview">
    <view class="card-header">
      <text class="card-title">我的订单</text>
      <text class="card-more" bindtap="onGoMyOrders">全部订单 ></text>
    </view>

    <view class="stat-row">
      <view class="stat-item" data-status="0" bindtap="onGoMyOrders">
        <text class="stat-num stat-pending">{{orderCounts.pending}}</text>
        <text class="stat-label">待支付</text>
      </view>
      <view class="stat-item" data-status="1" bindtap="onGoMyOrders">
        <text class="stat-num stat-paid">{{orderCounts.paid}}</text>
        <text class="stat-label">已支付</text>
      </view>
      <view class="stat-item" data-status="2" bindtap="onGoMyOrders">
        <text class="stat-num stat-completed">{{orderCounts.completed}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-item" data-status="3" bindtap="onGoMyOrders">
        <text class="stat-num stat-cancelled">{{orderCounts.cancelled}}</text>
        <text class="stat-label">已取消</text>
      </view>
    </view>
  </view>

  <!-- ========== 最近一笔订单（有订单时显示） ========== -->
  <view wx:if="{{isLoggedIn && latestOrder}}" class="card latest-order" bindtap="onGoMyOrders">
    <view class="card-header">
      <text class="card-title">最近订单</text>
      <text class="order-status status-{{latestOrder.status}}">{{latestOrder.status_text}}</text>
    </view>
    <view class="latest-row">
      <text class="latest-no">{{latestOrder.order_no}}</text>
      <text class="latest-total">¥{{latestOrder.total_price}}</text>
    </view>
    <text class="latest-time">{{latestOrder.created_at}}</text>
  </view>

  <!-- ========== 个人信息 ========== -->
  <view wx:if="{{isLoggedIn}}" class="card">
    <view class="card-header">
      <text class="card-title">个人信息</text>
    </view>

    <view class="info-row">
      <text class="label">用户名</text>
      <text class="value">{{userInfo.username || '未设置'}}</text>
    </view>
    <view class="info-row">
      <text class="label">昵称</text>
      <input wx:if="{{isEditing}}" class="info-input" value="{{editNickname}}" bindinput="onNickInput" />
      <text wx:else class="value">{{userInfo.nickname || '未设置'}}</text>
    </view>
    <view class="info-row">
      <text class="label">手机号</text>
      <input wx:if="{{isEditing}}" class="info-input" type="number" maxlength="11" value="{{editPhone}}" bindinput="onPhoneInput" />
      <text wx:else class="value">{{userInfo.phone || '未设置'}}</text>
    </view>
    <view class="info-row info-row-last">
      <text class="label">地址</text>
      <input wx:if="{{isEditing}}" class="info-input" value="{{editAddress}}" bindinput="onAddrInput" />
      <text wx:else class="value">{{userInfo.address || '未设置'}}</text>
    </view>

    <view wx:if="{{isEditing}}" class="btn-group">
      <button class="save-btn" bindtap="onSave">保存</button>
      <button class="cancel-btn" bindtap="onCancelEdit">取消</button>
    </view>
  </view>

  <!-- ========== 功能入口 ========== -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="onGoMyOrders">
      <text class="menu-text">📋 我的订单</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item menu-item-last" bindtap="onGoAbout">
      <text class="menu-text">ℹ️ 关于我们</text>
      <!-- 小味头像：纯装饰，不拦截点击（parent 的 bindtap 照常响应） -->
      <image
        class="menu-avatar"
        src="/assets/xiaowei/ui/xiaowei-avatar.png"
        mode="aspectFit"
        aria-hidden="{{true}}"
      />
      <text class="arrow">></text>
    </view>
  </view>

  <!-- ========== 退出登录 ========== -->
  <view wx:if="{{isLoggedIn}}" class="logout-wrap">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>

<!-- 用户中心页面 -->
<view class="container">
  <!-- 已登录状态 -->
  <block wx:if="{{isLoggedIn}}">
    <!-- 用户头像昵称区域 -->
    <view class="user-header">
      <image class="avatar" src="{{userInfo.avatar_url || '/images/default_avatar.png'}}" mode="aspectFill" />
      <view class="user-name">{{userInfo.nickname || userInfo.username || '微信用户'}}</view>
      <view class="user-phone">{{userInfo.phone || ''}}</view>
    </view>

    <!-- 订单展示区域 -->
    <view class="orders-section">
      <view class="section-title">📋 历史订单（已完成）</view>
      
      <view wx:if="{{completedOrders.length === 0}}" class="no-orders">
        <text>暂无已完成订单</text>
      </view>
      
      <view wx:for="{{completedOrders}}" wx:key="id" class="order-card">
        <!-- 订单状态：由后端返回的 status_text（旧代码用数字与字符串比较，永远不成立） -->
        <view class="order-status">{{item.status_text}}</view>
        <!-- 订单时间 -->
        <view class="order-time">{{item.created_at}}</view>
        <!-- 菜品图片横向滚动 -->
        <scroll-view class="dish-scroll" scroll-x="true">
          <view class="dish-images">
            <view wx:for="{{item.items}}" wx:for-item="dish" wx:key="dish_name" class="dish-img-wrap">
              <image class="dish-img" src="{{dish.image_url || '/images/default_dish.png'}}" mode="aspectFill" />
            </view>
          </view>
          <view class="dish-count">共 {{item.items.length}} 件</view>
        </scroll-view>
        <view class="order-total">¥{{item.total_price}}</view>
      </view>
    </view>

    <!-- 信息编辑区域 -->
    <view class="info-section">
      <view class="section-title">个人信息</view>
      <view class="info-row">
        <text class="label">用户名</text>
        <text class="value">{{userInfo.username}}</text>
      </view>
      <view class="info-row">
        <text class="label">昵称</text>
        <input wx:if="{{isEditing}}" class="info-input" value="{{editNickname}}" bindinput="onNickInput" />
        <text wx:else class="value">{{userInfo.nickname}}</text>
      </view>
      <view class="info-row">
        <text class="label">手机号</text>
        <input wx:if="{{isEditing}}" class="info-input" value="{{editPhone}}" bindinput="onPhoneInput" />
        <text wx:else class="value">{{userInfo.phone || '未设置'}}</text>
      </view>
      <view class="info-row">
        <text class="label">地址</text>
        <input wx:if="{{isEditing}}" class="info-input" value="{{editAddress}}" bindinput="onAddrInput" />
        <text wx:else class="value">{{userInfo.address || '未设置'}}</text>
      </view>

      <view class="btn-group">
        <button wx:if="{{!isEditing}}" class="edit-btn" bindtap="onEdit">编辑</button>
        <button wx:if="{{isEditing}}" class="save-btn" bindtap="onSave">保存</button>
        <button wx:if="{{isEditing}}" class="cancel-btn" bindtap="onCancelEdit">取消</button>
        <button class="logout-btn" bindtap="onLogout">退出登录</button>
      </view>
    </view>
  </block>

  <!-- 未登录状态 -->
  <block wx:else>
    <view class="login-prompt">
      <view class="prompt-icon">👤</view>
      <text class="prompt-text">暂未登录</text>
      <text class="prompt-desc">登录后查看订单和更多功能</text>
      
      <view class="auth-btns">
        <!-- 跳转注册页 -->
        <button class="register-btn" bindtap="onGoRegister">注册</button>
        <!-- 跳转登录页 -->
        <button class="login-btn" bindtap="onGoLogin">登录</button>
      </view>
    </view>
  </block>

  <!-- 功能入口 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onGoAbout">
      <text>ℹ️ 关于我们</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>
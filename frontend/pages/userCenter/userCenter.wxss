/* 用户中心（「我的」）样式 */

.container {
    min-height: 100vh;
    background: #f5f5f5;
    padding-bottom: 60rpx;
  }
  
  /* ========== 顶部用户卡（渐变） ========== */
  .hero {
    background: linear-gradient(135deg, #FF8A5B 0%, #FF6B35 100%);
    padding: 50rpx 40rpx 70rpx;
    border-radius: 0 0 40rpx 40rpx;
  }
  
  .hero-main {
    display: flex;
    align-items: center;
    gap: 24rpx;
  }
  
  .avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 4rpx solid rgba(255, 255, 255, 0.6);
    flex-shrink: 0;
  }
  
  /* 无头像时的占位（避免引用不存在的图片渲染成空白圆圈） */
  .avatar-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 56rpx;
  }
  
  .hero-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10rpx;
    min-width: 0;
  }
  
  .hero-name {
    font-size: 38rpx;
    font-weight: bold;
    color: #fff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .hero-sub {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.85);
  }
  
  .hero-btn {
    flex-shrink: 0;
    font-size: 24rpx;
    color: #FF6B35;
    background: #fff;
    padding: 12rpx 28rpx;
    border-radius: 30rpx;
  }
  
  .hero-btn:active {
    opacity: 0.8;
  }
  
  /* ========== 通用卡片 ========== */
  .card {
    background: #fff;
    margin: 20rpx;
    padding: 30rpx;
    border-radius: 20rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  }
  
  /* 第一张卡片上移，压住渐变头部形成层次感 */
  .orders-overview {
    margin-top: -40rpx;
    position: relative;
    z-index: 1;
  }
  
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24rpx;
  }
  
  .card-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .card-more {
    font-size: 26rpx;
    color: #FF6B35;
  }
  
  /* ========== 订单概览：各状态数量 ========== */
  .stat-row {
    display: flex;
  }
  
  .stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8rpx;
  }
  
  .stat-item:active {
    opacity: 0.7;
  }
  
  .stat-num {
    font-size: 42rpx;
    font-weight: bold;
    line-height: 1.2;
    color: #333;
  }
  
  .stat-label {
    font-size: 24rpx;
    color: #999;
  }
  
  /* 待支付用主色突出，其余按语义着色 */
  .stat-pending { color: #FF6B35; }
  .stat-paid { color: #2d8cf0; }
  .stat-completed { color: #19be6b; }
  .stat-cancelled { color: #bbb; }
  
  /* ========== 最近订单 ========== */
  .latest-order:active {
    background: #fafafa;
  }
  
  .order-status {
    font-size: 26rpx;
    font-weight: bold;
  }
  
  /* 订单状态配色：0待支付 1已支付 2已完成 3已取消 */
  .status-0 { color: #FF6B35; }
  .status-1 { color: #2d8cf0; }
  .status-2 { color: #19be6b; }
  .status-3 { color: #999; }
  
  .latest-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  
  .latest-no {
    font-size: 26rpx;
    color: #666;
  }
  
  .latest-total {
    font-size: 34rpx;
    font-weight: bold;
    color: #FF6B35;
  }
  
  .latest-time {
    display: block;
    font-size: 24rpx;
    color: #bbb;
    margin-top: 10rpx;
  }
  
  /* ========== 个人信息 ========== */
  .info-row {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1px solid #f5f5f5;
  }
  
  .info-row-last {
    border-bottom: none;
  }
  
  .label {
    width: 130rpx;
    font-size: 28rpx;
    color: #999;
    flex-shrink: 0;
  }
  
  .value {
    flex: 1;
    font-size: 28rpx;
    color: #333;
  }
  
  .info-input {
    flex: 1;
    font-size: 28rpx;
    background: #f7f7f7;
    border-radius: 10rpx;
    padding: 14rpx 20rpx;
  }
  
  .btn-group {
    display: flex;
    gap: 20rpx;
    margin-top: 30rpx;
  }
  
  .save-btn,
  .cancel-btn {
    flex: 1;
    font-size: 28rpx;
    line-height: 2.4;
    border-radius: 40rpx;
    margin: 0;
  }
  
  .save-btn {
    background: #FF6B35;
    color: #fff;
  }
  
  .cancel-btn {
    background: #f5f5f5;
    color: #666;
  }
  
  /* ========== 功能入口 ========== */
  .menu-card {
    padding: 0 30rpx;
  }
  
  .menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 0;
    border-bottom: 1px solid #f5f5f5;
  }
  
  .menu-item-last {
    border-bottom: none;
  }
  
  .menu-item:active {
    background: #fafafa;
  }
  
  .menu-text {
    font-size: 30rpx;
    color: #333;
  }
  
  .arrow {
    color: #ccc;
    font-size: 28rpx;
  }
  
  /* ========== 退出登录 ========== */
  .logout-wrap {
    margin: 40rpx 20rpx 0;
  }
  
  .logout-btn {
    background: #fff;
    color: #ff4444;
    font-size: 30rpx;
    line-height: 2.6;
    border-radius: 20rpx;
    margin: 0;
  }

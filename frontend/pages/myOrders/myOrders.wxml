<!-- 我的订单页面 -->
<view class="container">
  <!-- 状态筛选栏（未登录时不显示） -->
  <view wx:if="{{!needLogin}}" class="filter-bar">
    <view
      wx:for="{{filters}}"
      wx:key="value"
      class="filter-item {{item.value === activeStatus ? 'filter-active' : ''}}"
      data-status="{{item.value}}"
      bindtap="onFilterTap"
    >{{item.label}}</view>
  </view>

  <!-- 未登录提示 -->
  <view wx:if="{{needLogin}}" class="empty">
    <text class="empty-icon">🔒</text>
    <text class="empty-text">请先登录</text>
    <text class="empty-hint">登录后即可查看您的订单</text>
    <button class="login-btn" bindtap="onGoLogin">去登录</button>
  </view>

  <!-- 空订单提示（按当前筛选给出不同文案） -->
  <view wx:elif="{{isEmpty}}" class="empty">
    <text class="empty-icon">📋</text>
    <text class="empty-text">{{activeStatus === -1 ? '暂无订单记录' : '该状态下暂无订单'}}</text>
    <text class="empty-hint">快去首页点餐吧</text>
    <button class="login-btn" bindtap="onGoIndex">去点餐</button>
  </view>

  <!-- 订单列表 -->
  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="id" class="order-card">
      <view class="order-header">
        <text class="order-no">订单号：{{item.order_no}}</text>
        <text class="order-status status-{{item.status}}">{{item.status_text}}</text>
      </view>

      <view wx:for="{{item.items}}" wx:for-item="dish" wx:key="dish_name" class="order-dish">
        <text class="dish-name">{{dish.dish_name}}</text>
        <text class="dish-qty">x{{dish.quantity}}</text>
        <text class="dish-price">¥{{dish.dish_price}}</text>
      </view>

      <view wx:if="{{item.remark}}" class="order-remark">备注：{{item.remark}}</view>

      <view class="order-footer">
        <text class="total-label">合计：</text>
        <text class="total-price">¥{{item.total_price}}</text>
      </view>

      <view class="order-time">{{item.created_at}}</view>

      <!-- 订单操作按钮：用 view 而非 button（button 自带块级默认宽度，在 flex 行里会撑满/溢出） -->
      <view wx:if="{{item.can_pay || item.can_cancel || item.can_complete}}" class="order-actions">
        <view wx:if="{{item.can_cancel}}" class="btn btn-plain" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onCancel">取消订单</view>
        <view wx:if="{{item.can_pay}}" class="btn btn-primary" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onPay">去支付</view>
        <view wx:if="{{item.can_complete}}" class="btn btn-primary" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onComplete">确认完成</view>
      </view>
    </view>
  </view>
</view>

/* pages/myOrders/myOrders.wxss */

.container {
    min-height: 100vh;
    background: #f5f5f5;
    padding: 0 0 20rpx;
  }
  
  /* 状态筛选栏（吸顶） */
  .filter-bar {
    display: flex;
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  }
  
  .filter-item {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    color: #666;
    padding: 24rpx 0;
    position: relative;
  }
  
  .filter-active {
    color: #FF6B35;
    font-weight: bold;
  }
  
  /* 选中态下划线 */
  .filter-active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 8rpx;
    transform: translateX(-50%);
    width: 44rpx;
    height: 6rpx;
    background: #FF6B35;
    border-radius: 3rpx;
  }
  
  /* 空状态 / 未登录 */
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 200rpx;
  }
  
  .empty-icon {
    font-size: 100rpx;
  }
  
  .empty-text {
    font-size: 32rpx;
    color: #999;
    margin-top: 20rpx;
  }
  
  .empty-hint {
    font-size: 26rpx;
    color: #ccc;
    margin-top: 10rpx;
  }
  
  .login-btn {
    margin-top: 40rpx;
    background: #FF6B35;
    color: #fff;
    font-size: 30rpx;
    padding: 15rpx 60rpx;
    border-radius: 10rpx;
  }
  
  /* 订单卡片 */
  .order-card {
    background: #fff;
    margin: 10rpx 20rpx 20rpx;
    padding: 20rpx;
    border-radius: 15rpx;
  }
  
  .order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 15rpx;
    border-bottom: 1px solid #f0f0f0;
  }
  
  .order-no {
    font-size: 24rpx;
    color: #999;
  }
  
  /* 订单状态：按状态区分颜色 */
  .order-status {
    font-size: 26rpx;
    font-weight: bold;
  }
  
  .status-0 {
    color: #FF6B35;   /* 待支付 */
  }
  
  .status-1 {
    color: #2d8cf0;   /* 已支付 */
  }
  
  .status-2 {
    color: #19be6b;   /* 已完成 */
  }
  
  .status-3 {
    color: #999;      /* 已取消 */
  }
  
  /* 订单明细 */
  .order-dish {
    display: flex;
    justify-content: space-between;
    font-size: 28rpx;
    color: #333;
    padding: 12rpx 0;
  }
  
  .dish-name {
    flex: 1;
  }
  
  .dish-qty {
    width: 100rpx;
    text-align: center;
    color: #999;
  }
  
  .dish-price {
    width: 140rpx;
    text-align: right;
  }
  
  .order-remark {
    font-size: 24rpx;
    color: #999;
    padding-top: 10rpx;
  }
  
  /* 合计 */
  .order-footer {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    padding-top: 15rpx;
    border-top: 1px solid #f0f0f0;
    font-size: 28rpx;
  }
  
  .total-label {
    color: #666;
  }
  
  .total-price {
    color: #FF6B35;
    font-size: 34rpx;
    font-weight: bold;
  }
  
  .order-time {
    font-size: 24rpx;
    color: #bbb;
    padding-top: 10rpx;
  }
  
  /* 操作按钮区 */
  .order-actions {
    display: flex;
    justify-content: flex-end;
    padding-top: 20rpx;
  }
  
  /* 订单操作按钮：同样要重置 button 默认的块级宽度，按内容宽度显示 */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 0;
    flex: none;
    margin: 0 0 0 16rpx;
    height: 58rpx;
    padding: 0 30rpx;
    line-height: 58rpx;
    font-size: 26rpx;
    border-radius: 30rpx;
    box-sizing: border-box;
  }
  
  /* 去掉 button 组件自带的 ::after 边框（.btn-plain 自己的 border 不受影响） */
  .btn::after {
    border: none;
  }
  
  /* 主要操作（去支付 / 确认完成） */
  .btn-primary {
    background: #FF6B35;
    color: #fff;
  }
  
  /* 次要操作（取消订单） */
  .btn-plain {
    background: #fff;
    color: #666;
    border: 1px solid #ddd;
  }

/* pages/myOrders/myOrders.wxss */

.container {
    min-height: 100vh;
    background: #f5f5f5;
    padding: 20rpx 0;
  }
  
  /* 空状态 / 未登录 */
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 200rpx;
  }
  
  .empty-icon {
    font-size: 100rpx;
  }
  
  .empty-text {
    font-size: 32rpx;
    color: #999;
    margin-top: 20rpx;
  }
  
  .empty-hint {
    font-size: 26rpx;
    color: #ccc;
    margin-top: 10rpx;
  }
  
  .login-btn {
    margin-top: 40rpx;
    background: #FF6B35;
    color: #fff;
    font-size: 30rpx;
    padding: 15rpx 60rpx;
    border-radius: 10rpx;
  }
  
  /* 订单卡片 */
  .order-card {
    background: #fff;
    margin: 10rpx 20rpx 20rpx;
    padding: 20rpx;
    border-radius: 15rpx;
  }
  
  .order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 15rpx;
    border-bottom: 1px solid #f0f0f0;
  }
  
  .order-no {
    font-size: 24rpx;
    color: #999;
  }
  
  /* 订单状态：按状态区分颜色 */
  .order-status {
    font-size: 26rpx;
    font-weight: bold;
  }
  
  .status-0 {
    color: #FF6B35;   /* 待支付 */
  }
  
  .status-1 {
    color: #2d8cf0;   /* 已支付 */
  }
  
  .status-2 {
    color: #19be6b;   /* 已完成 */
  }
  
  .status-3 {
    color: #999;      /* 已取消 */
  }
  
  /* 订单明细 */
  .order-dish {
    display: flex;
    justify-content: space-between;
    font-size: 28rpx;
    color: #333;
    padding: 12rpx 0;
  }
  
  .dish-name {
    flex: 1;
  }
  
  .dish-qty {
    width: 100rpx;
    text-align: center;
    color: #999;
  }
  
  .dish-price {
    width: 140rpx;
    text-align: right;
  }
  
  .order-remark {
    font-size: 24rpx;
    color: #999;
    padding-top: 10rpx;
  }
  
  /* 合计 */
  .order-footer {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    padding-top: 15rpx;
    border-top: 1px solid #f0f0f0;
    font-size: 28rpx;
  }
  
  .total-label {
    color: #666;
  }
  
  .total-price {
    color: #FF6B35;
    font-size: 34rpx;
    font-weight: bold;
  }
  
  .order-time {
    font-size: 24rpx;
    color: #bbb;
    padding-top: 10rpx;
  }
  
  /* 操作按钮区 */
  .order-actions {
    display: flex;
    justify-content: flex-end;
    padding-top: 20rpx;
  }
  
  .btn {
    font-size: 26rpx;
    padding: 10rpx 30rpx;
    border-radius: 30rpx;
    margin: 0 0 0 15rpx;
    line-height: 1.6;
  }
  
  /* 主要操作（去支付 / 确认完成） */
  .btn-primary {
    background: #FF6B35;
    color: #fff;
  }
  
  /* 次要操作（取消订单） */
  .btn-plain {
    background: #fff;
    color: #666;
    border: 1px solid #ddd;
  }
